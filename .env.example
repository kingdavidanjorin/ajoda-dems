# =========================================================
# APPLICATION
# =========================================================

APP_NAME="Ajoda GRA DEMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ajoda-dems.test

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database


# =========================================================
# PASSWORD HASHING
# =========================================================

HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
HASH_VERIFY=true


# =========================================================
# DATABASE
# =========================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ajoda_dems
DB_USERNAME=
DB_PASSWORD=

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SOCKET=
DB_URL=

MYSQL_ATTR_SSL_CA=


# =========================================================
# SESSION
# =========================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true

SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SESSION_CONNECTION=
SESSION_TABLE=sessions

AUTH_PASSWORD_TIMEOUT=900


# =========================================================
# CACHE
# =========================================================

CACHE_STORE=database
CACHE_PREFIX=ajoda-dems-cache

DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks


# =========================================================
# QUEUE
# =========================================================

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90


# =========================================================
# FILE STORAGE
# =========================================================

FILESYSTEM_DISK=local


# =========================================================
# MAIL
# =========================================================

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=

MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

MAIL_LOG_CHANNEL=


# =========================================================
# THIRD-PARTY EMAIL SERVICES
# Leave blank when the service is not used.
# =========================================================

POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=

RESEND_API_KEY=


# =========================================================
# AWS / S3 / SES / SQS / DYNAMODB
# Leave blank when AWS services are not used.
# =========================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=


# =========================================================
# REDIS
# Leave blank when Redis is not used.
# =========================================================

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379

REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default


# =========================================================
# MEMCACHED
# Leave blank when Memcached is not used.
# =========================================================

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=


# =========================================================
# LOGGING
# =========================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=:boom:

PAPERTRAIL_URL=
PAPERTRAIL_PORT=


# =========================================================
# SLACK NOTIFICATIONS
# =========================================================

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=


# =========================================================
# DEMS-SPECIFIC SETTINGS
# =========================================================

# Application and database timestamps remain in UTC.
# Dates shown to Ajoda GRA users use this business timezone.
DEMS_BUSINESS_TIMEZONE=Africa/Lagos

DEMS_CURRENCY=NGN
DEMS_PAGINATION_PER_PAGE=15
DEMS_RESERVATION_HOLD_HOURS=72
DEMS_DEFAULT_CUSTOMER_COUNTRY=Nigeria

# Local authentication diagnostics.
# These must remain disabled in staging and production.
DEMS_WRITE_LOCAL_AUTH_LINKS=false
DEMS_RESET_LINK_FILENAME=staff-setup-link.txt
DEMS_VERIFICATION_LINK_FILENAME=verification-link.txt